# Docker 部署配置 —— 复制为 .env 后按需修改
# cp .env.example .env

# 后端地址（浏览器直接访问的地址，必须填 NAS 的局域网 IP，不能填 localhost）
# 修改后必须重新构建前端镜像：docker compose up -d --build frontend
NAPICS_API_URL=http://192.168.1.100:8001

# 宿主机媒体库目录（飞牛 OS 一般在 /vol1/1000/ 下，群晖一般是 /volume1/）
MEDIA_PATH=/vol1/1000/视频

# 端口映射
FRONTEND_PORT=3032
BACKEND_PORT=8001

# 时区
TZ=Asia/Shanghai
