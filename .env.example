# Docker Compose 部署配置 —— 复制为 .env 后按需修改
# cp .env.example .env
#
# 如果用 NAS 图形界面建容器，不需要这个文件，直接在界面里填对应的
# 端口映射、目录挂载和环境变量即可（见 README）。

# 宿主机媒体库目录（必填）
# 飞牛 OS 一般在 /vol1/1000/ 下，群晖一般是 /volume1/，威联通是 /share/
# 注意：容器内固定挂载为 /media，设置页填扫描路径时要填 /media/...
MEDIA_PATH=/vol1/1000/视频

# 访问端口（只需要这一个）
FRONTEND_PORT=3032

# 镜像标签：release 分支为 latest，开发版填 dev
NAPICS_TAG=latest

# 时区
TZ=Asia/Shanghai
