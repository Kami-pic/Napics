# Docker Compose 部署配置 —— 复制为 .env 后按需修改
# cp .env.example .env
#
# 如果用 NAS 图形界面建容器，不需要这个文件，直接在界面里填对应的
# 端口映射、目录挂载和环境变量即可（见 README）。

# 媒体库目录（必填）
# 容器内外使用同一个路径，所以设置页里直接填这个路径就行，不用做转换。
# 飞牛 OS 一般在 /vol1/1000/ 或 /vol2/1000/ 下，群晖是 /volume1/，威联通是 /share/
MEDIA_PATH=/vol1/1000/video

# 访问端口（只需要这一个）
FRONTEND_PORT=3032

# 镜像标签：release 分支为 latest，开发版填 dev
NAPICS_TAG=latest

# 时区
TZ=Asia/Shanghai
