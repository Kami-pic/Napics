#!/bin/sh

set -e

if command -v python >/dev/null 2>&1; then
  python scripts/check_todo_boundary.py
  python scripts/check_stage_docs.py
elif command -v py >/dev/null 2>&1; then
  py -3 scripts/check_todo_boundary.py
  py -3 scripts/check_stage_docs.py
else
  echo "未找到 python/py，无法执行提交流程检查。"
  exit 1
fi
