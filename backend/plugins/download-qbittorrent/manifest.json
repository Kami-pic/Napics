{
    "id": "download-qbittorrent",
    "name": "qBittorrent",
    "version": "1.0.0",
    "description": "BT 下载器，支持一键下载、进度追踪、自动整理",
    "category": "download",
    "icon": "⬇️",
    "requires_config": ["qb_url", "qb_username", "qb_password"],
    "config_schema": [
        {
            "key": "qb_url",
            "label": "qBittorrent 地址",
            "type": "url",
            "description": "填 Napics 后端能访问到的地址。同机部署用 127.0.0.1；qB 在 NAS 或别的机器上填它的局域网 IP；Napics 在 Docker 里而 qB 在宿主机上填 host.docker.internal",
            "placeholder": "http://<主机地址>:8080",
            "required": true
        },
        {
            "key": "qb_username",
            "label": "qBittorrent 用户名",
            "type": "text",
            "required": true
        },
        {
            "key": "qb_password",
            "label": "qBittorrent 密码",
            "type": "password",
            "required": true
        }
    ],
    "depends_on": [],
    "provides": ["DownloadBackend:qbittorrent"],
    "risk_level": "medium"
}
