# nas-download-mcp 配置。凭据不读 napics config.json，全走这里。

MCP_HOST=0.0.0.0
MCP_PORT=8787

# napics 后端（注意 :8001 后端，不是 :3032 前端）。改成你的 NAS 地址。
NAPICS_API_BASE=http://<nas-host>:8001
NAPICS_AGENT_TOKEN=

# docker 白名单容器（qB 不在内）。填你部署里的真实容器名。
NAPICS_CONTAINER=napics
PROWLARR_CONTAINER=prowlarr

# 外部服务
PROWLARR_URL=http://<nas-host>:9696
# ⚠️ 这个 QB_URL 必须和 napics 里配的 qB 指向同一个 qB 实例，否则监控/删种对不上
QB_URL=http://<nas-host>:8085
QB_USERNAME=admin
QB_PASSWORD=

# 测速探测
PROBE_BATCH_SIZE=3
PROBE_INTERVAL_SECONDS=5
PROBE_TIMEOUT_SECONDS=120
PROBE_MIN_SPEED_BYTES=10240
STABILIZATION_WINDOW_SECONDS=10

# 下载/后处理超时
PROCESSING_TIMEOUT_SECONDS=1800
DOWNLOAD_TIMEOUT_SECONDS=0

# 服务生命周期（true=下完释放内存，即便任务开始时容器本已在跑也停）
STOP_SERVICES_AFTER_TASK=true
RECOVER_ACTIVE_DOWNLOAD=true

# 持久化
DATABASE_PATH=/app/data/tasks.db
LOG_PATH=/app/logs

# 推送渠道（§9 待定）：留空=只记日志；bark 需 BARK_URL；telegram 需 TELEGRAM_BOT_TOKEN+TELEGRAM_CHAT_ID
NOTIFY_CHANNEL=
# BARK_URL=https://api.day.app/xxxxx
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
